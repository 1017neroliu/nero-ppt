# Nero PPT 环境配置示例。复制为 .env 并按需修改；密钥不得入库。
# 数据目录与数据库
NERO_DATA_DIR=./data
NERO_DB_PATH=./data/nero.db

# 鉴权：demo（仅绑定 127.0.0.1 的本地演示）或 password（独立凭据 + 会话）
NERO_AUTH_MODE=demo
NERO_SESSION_SECRET=change-me-to-a-long-random-string

# 模型（OpenAI 兼容协议；未配置 API key 时模型功能显式不可用）
# 提示：模型可用性可在新建任务页点击"测试可用性"验证；密钥缺失时任务启动会被拦截
# 多模型选择：在 data/config/models.json 维护模型目录（支持 api_key_env 引用环境变量），
# 用户在新建任务页按任务选择；此处环境变量作为默认档（id=default）。
NERO_MODEL_PROVIDER=openai
NERO_MODEL_BASE_URL=https://api.openai.com/v1
NERO_MODEL_NAME=gpt-4o-mini
NERO_MODEL_API_KEY=
NERO_MODEL_TIMEOUT_SECONDS=120

# 上传与资源限制
NERO_MAX_UPLOAD_MB=30
NERO_MAX_JOB_INPUT_MB=100
NERO_MAX_OUTPUT_SLIDES=60
NERO_MIN_FREE_DISK_MB=2048

# QA 自动修复轮数上限
NERO_MAX_REPAIR_ROUNDS=2
